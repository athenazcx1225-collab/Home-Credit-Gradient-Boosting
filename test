    INST_DPD_MEAN=("DPD", "mean"),
    INST_DPD_MAX=("DPD", "max"),
    INST_PAYMENT_RATIO_MEAN=("PAYMENT_RATIO", "mean"),
    INST_PAYMENT_DIFF_MEAN=("PAYMENT_DIFF", "mean"),
    INST_PAYMENT_AMOUNT_SUM=("AMT_PAYMENT", "sum"),
